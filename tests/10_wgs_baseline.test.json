    "Prepare Directories.folder_name": "wgs_baseline"
  },
  "skip": [
    "Generate VSBatch File for VSPipeline",
    "Create VarSeq Project with VSPipeline",
    "Run VarSeq Reports"
  ],
  "output_folder": "/opt/ghdata/share/devdata/vsw workflows data/test/sentieon-secondary-analysis/wgs_baseline",
  "expected_outputs": [
    "**/*_deduped.cram",
    "**/*_dnascope.vcf.gz",
    "**/*_cnvscope.vcf.gz",
    "**/*_sv.vcf.gz",
    "**/*_ehunter.vcf.gz",
    "**/*_gangstr.vcf.gz",
    "**/*_cypcall.json",
    "**/*.segdup.*.vcf.gz"
  ]
